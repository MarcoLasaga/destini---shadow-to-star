{
  "dataset_name": "Polyvore Fashion Dataset",
  "references": [
    "Han et al., 'Learning Fashion Compatibility with Bidirectional LSTMs', ACM MM 2017",
    "Vasileva et al., 'Learning Type-Aware Embeddings for Fashion Collection Retrieval', ECCV 2018"
  ],
  "version": "1.0",
  "dataset_root": {
    "environment_variable": "POLYVORE_ROOT",
    "description": "External dataset directory; not bundled in this repository."
  },
  "stylesense_taxonomy": [
    "TOP",
    "BOTTOM",
    "SHOES",
    "OUTERWEAR",
    "ACCESSORIES"
  ],
  "supported_layouts": {
    "han_acm_mm_2017": {
      "categories_file": "category_id.txt",
      "train_outfits": "train_no_dup.json",
      "val_outfits": "valid_no_dup.json",
      "test_outfits": "test_no_dup.json",
      "images_dir": "images"
    },
    "vasileva_eccv_2018": {
      "categories_file": "categories.csv",
      "item_metadata": "polyvore_item_metadata.json",
      "train_outfits": "train.json",
      "val_outfits": "valid.json",
      "test_outfits": "test.json",
      "compatibility_train": "compatibility_train.txt",
      "compatibility_val": "compatibility_valid.txt",
      "compatibility_test": "compatibility_test.txt",
      "images_dir": "images"
    }
  },
