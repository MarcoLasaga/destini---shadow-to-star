# Copy to ml-service/.env for local development. Never commit ml-service/.env.

# remove.bg background-removal keys (comma-separated pool and/or single key)
REMOVE_BG_API_KEYS=
REMOVE_BG_API_KEY=
REMOVE_BG_SIZE=preview
FORCE_REMBG=false

# Free Hugging Face Access Token (https://huggingface.co/settings/tokens, "Read" scope).
# Used by gradio_client to call yisol/IDM-VTON (fallback: Nymbo/Virtual-Try-On) for POST /try-on-2d.
# HUGGINGFACE_TOKEN is also accepted as an alias.
HF_TOKEN=

# Total seconds to wait for Hugging Face ZeroGPU VTON before falling back to the local
# Cladwell Studio compositor (keep below the server/ proxy timeout of 65 s).
VTON_TIMEOUT_SECONDS=50
# Set to true to skip ZeroGPU VTON entirely and always use the local compositor.
DISABLE_ZEROGPU_VTON=false

