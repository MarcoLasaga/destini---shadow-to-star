<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nav_bg">

    <!-- Nav Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Style"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:fontFamily="@font/baloo_tamma2_semibold"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sense"
                android:textColor="@color/accent_orange"
                android:textSize="20sp"
                android:fontFamily="@font/baloo_tamma2_semibold"
                android:textStyle="bold"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_nav_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Close"/>
    </RelativeLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

    <!-- Nav Items -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/nav_home"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="HOME"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/asd"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/nav_wardrobe"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="WARDROBE"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/baloo_tamma2_semibold"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/nav_add"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="ADD"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/asd"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/nav_generator"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="GENERATOR"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/asd"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/nav_planner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="PLANNER"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/asd"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/nav_feed"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="FEED"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/asd"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/nav_saved"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="SAVED"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/asd"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/nav_gaps"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="GAPS"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/asd"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/nav_eco"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="ECO"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/asd"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"/>

            <!-- Divider before Sign In -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"/>

            <!-- Sign In button -->
            <Button
                android:id="@+id/nav_btn_signin"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Sign In"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:fontFamily="@font/asd"
                android:background="@drawable/bg_sign_in"
                android:textAllCaps="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>