<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Main scrollable content -->
    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== NAVBAR ===== -->
            <RelativeLayout
                android:id="@+id/navbar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@color/bg_main"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <!-- Logo: Style + Sense -->
                <LinearLayout
                    android:id="@+id/logo_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Style"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:fontFamily="@font/baloo_tamma2_semibold"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sense"
                        android:textColor="@color/accent_orange"
                        android:textSize="20sp"
                        android:fontFamily="@font/baloo_tamma2_semibold"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Hamburger Menu -->
                <ImageButton
                    android:id="@+id/btn_menu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_menu"
                    android:contentDescription="Menu"/>
            </RelativeLayout>

            <!-- Divider under navbar -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"/>

            <!-- ===== HERO SECTION ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="52dp"
                android:paddingBottom="52dp"
                android:gravity="center">

                <!-- Tagline -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR DIGITAL WARDROBE ASSISTANT"
                    android:textColor="@color/accent_orange"
                    android:textSize="11sp"
                    android:letterSpacing="0.14"
                    android:fontFamily="@font/asd"
                    android:layout_marginBottom="12dp"/>

                <!-- Hero Title Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Never Ask "
                        android:textColor="@color/text_primary"
                        android:textSize="28sp"
                        android:fontFamily="@font/bagel_fat_one"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="\"What Should"
                        android:textColor="@color/accent_orange"
                    android:textSize="28sp"
                    android:fontFamily="@font/bagel_fat_one"
                    android:textStyle="italic"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="I Wear?\""
                    android:textColor="@color/accent_orange"
                    android:textSize="28sp"
                    android:fontFamily="@font/bagel_fat_one"
                    android:textStyle="italic"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Again"
                        android:textColor="@color/text_primary"
                        android:textSize="28sp"
                        android:fontFamily="@font/bagel_fat_one"/>
                </LinearLayout>

                <!-- Hero Description -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="StyleSense organizes your personal wardrobe and uses machine learning to generate perfect outfit combinations from clothes you already own."
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:fontFamily="@font/asd"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="32dp"/>

                <!-- CTA Buttons -->
                <Button
                    android:id="@+id/btn_get_started"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Get Started →"
                    android:textColor="@color/btn_dark_text"
                    android:textSize="15sp"
                    android:fontFamily="@font/baloo_tamma2_semibold"
                    android:background="@drawable/bg_button_dark"
                    android:layout_marginBottom="12dp"
                    android:textAllCaps="false"/>

                <Button
                    android:id="@+id/btn_demo"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="View Demo Wardrobe"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="@font/asd"
                    android:background="@drawable/bg_button_outline"
                    android:textAllCaps="false"/>
            </LinearLayout>

            <!-- ===== HOW IT WORKS SECTION ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_how_section"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp">

                <!-- How it works label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOW IT WORKS"
                    android:textColor="@color/text_label"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:fontFamily="@font/asd"
                    android:layout_marginBottom="16dp"/>

                <!-- 3 Step Cards Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <!-- Step 1 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_how_card"
                        android:padding="12dp"
                        android:layout_marginEnd="6dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_camera"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1. Upload Clothes"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:fontFamily="@font/baloo_tamma2_semibold"
                            android:gravity="center"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Snap or upload photos"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:fontFamily="@font/asd"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 2 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_how_card"
                        android:padding="12dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_tag"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2. Label &amp; Organize"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:fontFamily="@font/baloo_tamma2_semibold"
                            android:gravity="center"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Category, color, style"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:fontFamily="@font/asd"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 3 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_how_card"
                        android:padding="12dp"
                        android:layout_marginStart="6dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_sparkle"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3. Get Outfits"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:fontFamily="@font/baloo_tamma2_semibold"
                            android:gravity="center"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI generates combos"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:fontFamily="@font/asd"
                            android:gravity="center"/>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- Spacer -->
            <View android:layout_width="match_parent" android:layout_height="48dp"/>

            <!-- ===== CORE FEATURES SECTION ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <!-- Section label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CORE FEATURES"
                    android:textColor="@color/accent_orange"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:fontFamily="@font/asd"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp"/>

                <!-- Section title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Wardrobe, Smarter"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:fontFamily="@font/bagel_fat_one"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="28dp"/>

                <!-- Feature Card Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp"
                    android:weightSum="2">

                    <!-- Snap & Organize -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_white"
                        android:padding="16dp"
                        android:layout_marginEnd="6dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_snap"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Snap &amp; Organize"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/baloo_tamma2_semibold"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Upload or photograph your clothes. Categorize by color, style, fabric, and occasion."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="@font/asd"
                            android:lineSpacingExtra="3dp"/>
                    </LinearLayout>

                    <!-- Smart Outfit Generator -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_white"
                        android:padding="16dp"
                        android:layout_marginStart="6dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_generator"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Smart Outfit Generator"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/baloo_tamma2_semibold"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Content-based filtering creates outfits based on color harmony, style consistency, and occasion."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="@font/asd"
                            android:lineSpacingExtra="3dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Feature Card Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="48dp"
                    android:weightSum="2">

                    <!-- Collaborative Filtering -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_white"
                        android:padding="16dp"
                        android:layout_marginEnd="6dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_collab"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Collaborative Filtering"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/baloo_tamma2_semibold"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Learn from community patterns — discover outfit combinations similar users love."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="@font/asd"
                            android:lineSpacingExtra="3dp"/>
                    </LinearLayout>

                    <!-- Save & Track -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_white"
                        android:padding="16dp"
                        android:layout_marginStart="6dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_save"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Save &amp; Track"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/baloo_tamma2_semibold"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Save your favorite outfits, track what you wear, and get better recommendations over time."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="@font/asd"
                            android:lineSpacingExtra="3dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== CTA SECTION ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="48dp"
                android:paddingBottom="64dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready to Organize Your Closet?"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:fontFamily="@font/bagel_fat_one"
                    android:gravity="center"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload your clothes, let the algorithm work, and start wearing smarter outfits."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="@font/asd"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="28dp"/>

                <Button
                    android:id="@+id/btn_create_wardrobe"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Create Your Wardrobe →"
                    android:textColor="@color/btn_dark_text"
                    android:textSize="15sp"
                    android:fontFamily="@font/baloo_tamma2_semibold"
                    android:background="@drawable/bg_button_dark"
                    android:textAllCaps="false"/>
            </LinearLayout>

            <!-- ===== FOOTER ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/footer_bg"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginBottom="20dp"/>

                <!-- Footer Logo -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Style"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:fontFamily="@font/baloo_tamma2_semibold"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sense"
                        android:textColor="@color/accent_orange"
                        android:textSize="18sp"
                        android:fontFamily="@font/baloo_tamma2_semibold"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="© 2026 StyleSense — Personalized Outfit Recommendation System. Thesis Project."
                    android:textColor="@color/text_label"
                    android:textSize="11sp"
                    android:fontFamily="@font/asd"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ===== NAV OVERLAY (hidden by default) ===== -->
    <include
        android:id="@+id/nav_overlay"
        layout="@layout/nav_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

</FrameLayout>