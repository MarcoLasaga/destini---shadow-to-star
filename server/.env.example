# Copy to server/.env for local API development. Never commit server/.env.
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase project settings: use a publishable/anon key only.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# The locally hosted PyTorch image-analysis service.
CNN_ANALYSIS_URL=http://localhost:8000/analyze
