{
  "expo": {
    "name": "StyleSense",
    "slug": "StyleSense",
    "description": "Personalized Wardrobe and Outfit Recommendation Mobile Application. Developed by Shiloh Dynasty.",
    "scheme": "stylesense",
    "version": "1.0.0",
    "orientation": "portrait",
    "jsEngine": "hermes",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#364536"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#364536",
      "iosDisplayInForeground": true
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#00000000",
      "translucent": true,
      "hidden": true
    },
    "androidNavigationBar": {
      "visible": "immersive",
      "barStyle": "light-content",
      "backgroundColor": "#364536"
    },
    "android": {
      "package": "com.stylesense.app",
      "userInterfaceStyle": "light",
      "adaptiveIcon": {
        "backgroundColor": "#F8F9F3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#364536"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "StyleSense uses your photos to add clothing to your wardrobe.",
          "cameraPermission": "StyleSense uses your camera to add clothing to your wardrobe.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "StyleSense uses your location to show local weather and outfit suggestions."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "extra": {
      "appName": "StyleSense",
      "author": "Shiloh Dynasty",
      "applicationType": "Personalized Wardrobe and Outfit Recommendation Mobile Application",
      "eas": {
        "projectId": "93e16514-ca88-4c7e-aca1-7f0df3f231eb"
      }
    }
  }
}
